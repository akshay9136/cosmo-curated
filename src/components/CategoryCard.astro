---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Map category titles to icons + accent colors
const categoryConfig: Record<
  string,
  { icon: string; gradient: string; accentColor: string; number: string }
> = {
  'Stars & Galaxies': {
    icon: '✦',
    gradient: 'linear-gradient(135deg, #a855f7 0%, #6366f1 100%)',
    accentColor: '#a855f7',
    number: '01',
  },
  'Spacetime & Gravity': {
    icon: '⧖',
    gradient: 'linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%)',
    accentColor: '#3b82f6',
    number: '02',
  },
  'Black Holes': {
    icon: '◉',
    gradient: 'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)',
    accentColor: '#f59e0b',
    number: '03',
  },
  Cosmology: {
    icon: '◎',
    gradient: 'linear-gradient(135deg, #10b981 0%, #3b82f6 100%)',
    accentColor: '#10b981',
    number: '04',
  },
};

const config = categoryConfig[title] ?? {
  icon: '✧',
  gradient: 'linear-gradient(135deg, #6366f1 0%, #a855f7 100%)',
  accentColor: '#6366f1',
  number: '00',
};
---

<a
  href={`/articles?category=${encodeURIComponent(title)}`}
  class="category-tile"
  style={`--accent: ${config.accentColor}; --gradient: ${config.gradient};`}
>
  <!-- Left gradient accent strip -->
  <div class="accent-strip"></div>

  <!-- Main content -->
  <div class="tile-content">
    <div class="tile-header">
      <span class="tile-icon">{config.icon}</span>
      <span class="tile-number">{config.number}</span>
    </div>
    <h3 class="tile-title">{title}</h3>
    <p class="tile-desc">{description}</p>
    <div class="tile-cta">
      <span>Explore</span>
      <span>➔</span>
    </div>
  </div>
</a>

<style>
  .category-tile {
    position: relative;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(18, 18, 24, 0.85);
    backdrop-filter: blur(12px);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
    min-height: 200px;
  }

  .category-tile:hover {
    transform: translateY(-5px) scale(1.01);
    border-color: var(--accent);
  }

  /* Left gradient accent strip */
  .accent-strip {
    flex-shrink: 0;
    width: 4px;
    background: var(--gradient);
    border-radius: 16px 0 0 16px;
  }

  .tile-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .tile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }

  .tile-icon {
    font-size: 1.5rem;
    line-height: 1;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tile-number {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.2);
    font-variant-numeric: tabular-nums;
  }

  .tile-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #f4f4f5;
    margin: 0 0 0.6rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .tile-desc {
    font-size: 0.875rem;
    color: rgba(200, 200, 210, 0.6);
    line-height: 1.55;
    margin: 0 0 1.1rem;
    flex: 1;
  }

  .tile-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    transition: gap 0.2s ease;
  }

  .category-tile:hover .tile-cta {
    gap: 0.6rem;
  }
</style>
