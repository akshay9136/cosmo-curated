---
import { css, cx } from 'styled-system/css';
import { heading, bodyText, badge, card } from 'styled-system/recipes';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  heroImage?: string;
  publishedAt: Date;
  hashtags: string[];
}

const { id, title, description, category, heroImage, publishedAt } =
  Astro.props;

const cardStyle = cx(
  card(),
  css({
    display: 'flex',
    flexDirection: 'column',
    overflow: 'hidden',
    padding: 0,
    gap: 0,
    transform: 'translateY(0)',
    transition: 'all 0.3s ease, opacity 0.2s ease',
    _hover: {
      transform: 'translateY(-4px)',
      borderColor: 'accent.blue',
      boxShadow: 'soft',
    },
  })
);

const imageWrapperStyle = css({
  width: '100%',
  height: '200px',
  bgColor: 'cosmos.800',
  overflow: 'hidden',
});

const imageStyle = css({
  width: '100%',
  height: '100%',
  objectFit: 'cover',
  transition: 'transform 0.5s ease',
  _hover: { transform: 'scale(1.05)' },
});

const imagePlaceholderStyle = css({
  width: '100%',
  height: '200px',
  background: 'linear-gradient(45deg, #09090b 0%, #18181b 100%)',
});

const contentStyle = css({
  padding: 6,
  display: 'flex',
  flexDirection: 'column',
  flexGrow: 1,
});

const metaRowStyle = css({
  display: 'flex',
  justifyContent: 'space-between',
  alignItems: 'center',
  mb: 4,
});

const dateStyle = css({
  color: 'cosmos.400',
  fontSize: 'xs',
  fontWeight: 500,
});

const titleStyle = cx(
  heading({ size: 'h3' }),
  css({ mb: 3, flexGrow: 0 })
);

const descriptionStyle = cx(
  bodyText({ size: 'sm' }),
  css({
    flexGrow: 1,
    display: '-webkit-box',
    WebkitLineClamp: 3,
    overflow: 'hidden',
  })
);

const tagsContainerStyle = css({
  display: 'flex',
  flexWrap: 'wrap',
  gap: 2,
  mt: 'auto',
});

const tagStyle = css({
  fontSize: 'xs',
  color: 'cosmos.300',
  bgColor: 'rgba(255,255,255,0.05)',
  borderRadius: 'md',
  px: 2,
  py: 1,
});
---

<a
  href={`/articles/${id}`}
  data-article-card
  data-category={category}
  class={`article-card ${cardStyle}`}
>
  {
    heroImage ? (
      <div class={imageWrapperStyle}>
        <img
          src={heroImage}
          alt={title}
          class={imageStyle}
          width="600"
          height="200"
          loading="lazy"
        />
      </div>
    ) : (
      <div class={imagePlaceholderStyle} />
    )
  }

  <div class={contentStyle}>
    <div class={metaRowStyle}>
      <span class={badge({ variant: 'accent' })}>{category}</span>
      <span class={dateStyle}>
        {
          publishedAt.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })
        }
      </span>
    </div>

    <h2 class={titleStyle}>{title}</h2>

    <p class={descriptionStyle}>{description}</p>
  </div>
</a>
