---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { container } from 'styled-system/patterns';
import { css, cx } from 'styled-system/css';
import { section, heading, bodyText, badge } from 'styled-system/recipes';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;

// Render markdown content
let Content;
if (typeof render === 'function') {
  const rendered = await render(article);
  Content = rendered.Content;
} else if (typeof (article as any).render === 'function') {
  const rendered = await (article as any).render();
  Content = rendered.Content;
}

const backButtonStyle = css({
  mb: 8,
  display: 'inline-flex',
  alignItems: 'center',
  gap: 2,
  color: 'text.muted',
  fontSize: 'sm',
  transition: 'color 0.2s ease',
  _hover: { color: 'text.main' },
});

const metaRowStyle = css({
  display: 'flex',
  flexWrap: 'wrap',
  gap: 3,
  alignItems: 'center',
  mb: 4,
});

const dateTextStyle = css({
  color: 'cosmos.300',
  fontSize: 'sm',
});

const updatedTextStyle = css({
  color: 'cosmos.600',
  fontSize: 'xs',
});

const titleStyle = cx(heading({ size: 'h2' }), css({ mb: 4 }));

const heroImageWrapperStyle = css({
  borderRadius: 'xl',
  overflow: 'hidden',
  mb: 10,
  border: '1px solid',
  borderColor: 'rgba(255, 255, 255, 0.1)',
  boxShadow: 'soft',
});

const heroImageStyle = css({
  width: '100%',
  maxHeight: '480px',
  objectFit: 'cover',
});

const markdownContentStyle = css({
  color: 'text.main',
  fontFamily: 'body',
  lineHeight: 1.6,
  fontSize: 'lg',
  '& h1': {
    fontSize: '2.25rem',
    fontWeight: 'bold',
    fontFamily: 'heading',
    mt: 10,
    mb: 4,
    color: 'text.main',
  },
  '& h2': {
    fontSize: '1.75rem',
    fontWeight: 'bold',
    fontFamily: 'heading',
    mt: 8,
    mb: 4,
    color: 'text.main',
  },
  '& h3': {
    fontSize: '1.25rem',
    fontWeight: 'bold',
    fontFamily: 'heading',
    mt: 6,
    mb: 3,
    color: 'text.main',
  },
  '& p': { mb: 6, color: 'cosmos.300' },
  '& ul': { mb: 6, pl: 6, color: 'cosmos.300' },
  '& ol': {
    mb: 6,
    pl: 6,
    listStyleType: 'decimal',
    color: 'cosmos.300',
  },
  '& li': { mb: 2 },
  '& blockquote': {
    borderLeft: '4px solid',
    borderColor: 'accent.blue',
    px: 4,
    my: 6,
    bgColor: 'rgba(0, 242, 254, 0.05)',
    borderRadius: 'sm',
    fontStyle: 'italic',
    '& p': { py: 4, fontSize: 'md' },
  },
  '& code': {
    bgColor: 'cosmos.800',
    px: 2,
    py: 1,
    borderRadius: 'sm',
    fontSize: 'md',
    color: 'accent.blue',
  },
  '& pre': {
    bgColor: 'cosmos.800',
    padding: 4,
    borderRadius: 'lg',
    overflowX: 'auto',
    mb: 6,
    border: '1px solid',
    borderColor: 'cosmos.700',
  },
  '& img': { borderRadius: 'lg', my: 6, width: '100%' },
  '& strong': { color: 'text.main', fontWeight: 'semibold' },
  '& hr': {
    border: 'none',
    borderTop: '1px solid',
    borderColor: 'cosmos.600',
    my: 8,
  },
  '& table': {
    width: '100%',
    borderCollapse: 'separate',
    borderSpacing: 0,
    borderRadius: 'lg',
    overflow: 'hidden',
    border: '1px solid',
    borderColor: 'cosmos.800',
    fontSize: 'base',
    bgColor: 'rgba(15, 23, 42, 0.4)',
    mb: 8,
  },
  '& th': {
    bgColor: 'cosmos.800',
    color: 'text.main',
    fontWeight: 'bold',
    fontFamily: 'heading',
    textAlign: 'left',
    px: 6,
    py: 4,
    borderBottom: '1px solid',
    borderColor: 'cosmos.700',
  },
  '& td': {
    px: 6,
    py: 4,
    color: 'cosmos.300',
    borderBottom: '1px solid',
    borderColor: 'cosmos.800',
    lineHeight: 1.6,
    verticalAlign: 'top',
  },
  '& tr:last-child td': {
    borderBottom: 'none',
  },
  '& tr:nth-child(even) td': {
    bgColor: 'rgba(255, 255, 255, 0.02)',
  },
});

const tagsContainerStyle = css({
  pt: 8,
  borderTop: '1px solid',
  borderColor: 'cosmos.800',
  display: 'flex',
  flexWrap: 'wrap',
  gap: 2,
  alignItems: 'center',
});
---

<Layout title={`${article.data.title} | Cosmo Curated`}>
  <article class={section()}>
    <div class={container({ maxW: '4xl', px: 0 })}>
      {/* Back button */}
      <a href="/articles" class={backButtonStyle}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to Articles
      </a>

      {/* Header / Meta */}
      <div class={css({ mb: 8 })}>
        <div class={metaRowStyle}>
          <span class={badge({ variant: 'accent' })}>
            {article.data.category}
          </span>
          <span class={dateTextStyle}>
            {
              article.data.publishedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </span>
          {
            article.data.updatedAt && (
              <span class={updatedTextStyle}>
                (Updated:{' '}
                {article.data.updatedAt.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
                )
              </span>
            )
          }
        </div>

        <h1 class={titleStyle}>
          {article.data.title}
        </h1>

        <p class={bodyText({ size: 'lg' })}>
          {article.data.description}
        </p>
      </div>

      {/* Hero Image */}
      {
        article.data.heroImage && (
          <div class={heroImageWrapperStyle}>
            <img
              src={article.data.heroImage}
              alt={article.data.title}
              class={heroImageStyle}
            />
          </div>
        )
      }

      {/* Markdown Content */}
      <div class={markdownContentStyle}>
        {Content ? <Content /> : <p>Article content could not be loaded.</p>}
      </div>

      {/* Hashtags */}
      {
        article.data.hashtags && (
          <div class={tagsContainerStyle}>
            {article.data.hashtags.map((tag) => (
              <span class={badge({ variant: 'default' })}>#{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </article>
</Layout>
