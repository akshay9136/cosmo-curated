---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { container } from 'styled-system/patterns';
import { css, cx } from 'styled-system/css';
import { section, heading, bodyText, badge } from 'styled-system/recipes';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const {
  title,
  description,
  category,
  heroImage,
  hashtags = [],
  publishedAt,
  updatedAt,
  author = 'Cosmo Curated Editorial',
  readingTime: articleReadingTime,
  seoKeywords = [],
  faqs,
} = article.data;

// Render markdown content
let Content;
if (typeof render === 'function') {
  const rendered = await render(article);
  Content = rendered.Content;
} else if (typeof (article as any).render === 'function') {
  const rendered = await (article as any).render();
  Content = rendered.Content;
}

// --- Reading time (auto-derive: ~240 wpm average) ---
const wordCount = (article.body ?? '').trim().split(/\s+/).length;
const readingTime =
  articleReadingTime ?? Math.max(1, Math.round(wordCount / 240));

// --- JSON-LD: Article schema ---
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: heroImage ? new URL(heroImage, Astro.site).toString() : undefined,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Cosmo Curated',
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.site}favicon.svg`,
    },
  },
  url: new URL(`/articles/${article.id}`, Astro.site).toString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/articles/${article.id}`, Astro.site).toString(),
  },
  keywords: [...hashtags, ...seoKeywords].join(', '),
  articleSection: category,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['article h1', 'article .article-description'],
  },
  timeRequired: `PT${readingTime}M`,
};

// --- JSON-LD: BreadcrumbList ---
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: new URL('/articles', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: new URL(`/articles/${article.id}`, Astro.site).toString(),
    },
  ],
};

// --- JSON-LD: FAQPage (if faqs present) ---
const faqSchema =
  faqs && faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const schemas = [
  articleSchema,
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
];

const breadcrumbStyle = css({
  mb: 8,
  display: 'flex',
  alignItems: 'center',
  gap: 2,
  fontSize: 'sm',
  color: 'cosmos.600',
  flexWrap: 'wrap',

  '& > a': {
    color: 'text.muted',
    _hover: { color: 'text.main' },
    transition: 'color 0.2s',
  },

  '& > span': {
    color: 'cosmos.200',
  },
});

const metaRowStyle = css({
  display: 'flex',
  flexWrap: 'wrap',
  gap: 3,
  alignItems: 'center',
  mb: 4,
});

const readTimeStyle = css({
  color: 'cosmos.300',
  fontSize: 'sm',
  display: 'flex',
  alignItems: 'center',
  gap: 1,
});

const titleStyle = cx(heading({ size: 'h2' }), css({ mb: 4 }));

const heroImageWrapperStyle = css({
  borderRadius: 'xl',
  overflow: 'hidden',
  mb: 10,
  border: '1px solid',
  borderColor: 'rgba(255, 255, 255, 0.1)',
  boxShadow: 'soft',
});

const heroImageStyle = css({
  width: '100%',
  maxHeight: '480px',
  objectFit: 'cover',
});

const markdownContentStyle = css({
  color: 'text.main',
  fontFamily: 'body',
  lineHeight: 1.6,
  fontSize: 'lg',
  '& h1': {
    fontSize: '2.25rem',
    fontWeight: 'bold',
    fontFamily: 'heading',
    mt: 10,
    mb: 4,
    color: 'text.main',
  },
  '& h2': {
    fontSize: '1.75rem',
    fontWeight: 'bold',
    fontFamily: 'heading',
    mt: 8,
    mb: 4,
    color: 'text.main',
  },
  '& h3': {
    fontSize: '1.25rem',
    fontWeight: 'bold',
    fontFamily: 'heading',
    mt: 6,
    mb: 3,
    color: 'text.main',
  },
  '& p': { mb: 6, color: 'cosmos.300' },
  '& a': {
    color: 'accent.blue',
    textDecoration: 'underline',
    textUnderlineOffset: 4,
    transition: 'color 0.2s, text-decoration-color 0.2s',
    _hover: {
      color: 'accent.purple',
      textDecorationColor: 'accent.purple',
    },
  },
  '& ul': { mb: 6, pl: 6, listStyleType: 'disc', color: 'cosmos.300' },
  '& ol': { mb: 6, pl: 6, listStyleType: 'decimal', color: 'cosmos.300' },
  '& li': { mb: 2 },
  '& blockquote': {
    borderLeft: '4px solid',
    borderColor: 'accent.purple',
    px: 4,
    my: 6,
    bgColor: 'rgba(0, 242, 254, 0.05)',
    borderRadius: 'sm',
    fontStyle: 'italic',
    '& p': { py: 4, fontSize: 'md' },
  },
  '& code': {
    bgColor: 'cosmos.800',
    px: 2,
    py: 1,
    borderRadius: 'sm',
    fontSize: 'md',
    color: 'accent.purple',
  },
  '& pre': {
    bgColor: 'cosmos.800',
    padding: 4,
    borderRadius: 'lg',
    overflowX: 'auto',
    mb: 6,
    border: '1px solid',
    borderColor: 'cosmos.700',
  },
  '& img': { borderRadius: 'lg', my: 6, width: '100%' },
  '& strong': { color: 'text.main', fontWeight: 'semibold' },
  '& hr': {
    border: 'none',
    borderTop: '1px solid',
    borderColor: 'cosmos.600',
    my: 8,
  },
  '& table': {
    width: '100%',
    borderCollapse: 'separate',
    borderSpacing: 0,
    borderRadius: 'lg',
    overflow: 'hidden',
    border: '1px solid',
    borderColor: 'cosmos.800',
    fontSize: 'base',
    bgColor: 'rgba(15, 23, 42, 0.4)',
    mb: 8,
  },
  '& th': {
    bgColor: 'cosmos.800',
    color: 'text.main',
    fontWeight: 'bold',
    fontFamily: 'heading',
    textAlign: 'left',
    px: 6,
    py: 4,
    borderBottom: '1px solid',
    borderColor: 'cosmos.700',
  },
  '& td': {
    px: 6,
    py: 4,
    color: 'cosmos.300',
    borderBottom: '1px solid',
    borderColor: 'cosmos.800',
    lineHeight: 1.6,
    verticalAlign: 'top',
  },
  '& tr:last-child td': {
    borderBottom: 'none',
  },
  '& tr:nth-child(even) td': {
    bgColor: 'rgba(255, 255, 255, 0.02)',
  },
});

const tagsContainerStyle = css({
  pt: 8,
  borderTop: '1px solid',
  borderColor: 'cosmos.800',
  display: 'flex',
  flexWrap: 'wrap',
  gap: 2,
  alignItems: 'center',
});
---

<Layout
  title={`${title} | Cosmo Curated`}
  description={description}
  image={heroImage}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
  keywords={[...hashtags, ...seoKeywords]}
  schemas={schemas}
>
  <article class={section()}>
    <div class={container({ maxW: '4xl', px: 0 })}>
      {/* Breadcrumb nav */}
      <nav aria-label="Breadcrumb" class={breadcrumbStyle}>
        <a href="/">Home</a>
        <span aria-hidden="true">{'>'}</span>
        <a href="/articles">Articles</a>
        <span aria-hidden="true">{'>'}</span>
        <span aria-current="page">{title}</span>
      </nav>

      {/* Header / Meta */}
      <div class={css({ mb: 8 })}>
        <div class={metaRowStyle}>
          <span class={badge({ variant: 'accent' })}>
            {category}
          </span>
          <span class={css({ color: 'cosmos.300', fontSize: 'sm' })}>
            {
              publishedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </span>

          {/* Reading time */}
          <span class={readTimeStyle}>
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline>
            </svg>
            {readingTime} min read
          </span>
        </div>

        <h1 class={titleStyle}>
          {title}
        </h1>

        <p class={cx(bodyText({ size: 'lg' }), 'article-description')}>
          {description}
        </p>
      </div>

      {/* Hero Image */}
      {
        heroImage && (
          <div class={heroImageWrapperStyle}>
            <img
              src={heroImage}
              alt={title}
              class={heroImageStyle}
              width="1200"
              height="480"
              fetchpriority="high"
              loading="eager"
            />
          </div>
        )
      }

      {/* Markdown Content */}
      <div class={markdownContentStyle}>
        {Content ? <Content /> : <p>Article content could not be loaded.</p>}
      </div>

      {/* Hashtags */}
      {
        hashtags && hashtags.length > 0 && (
          <div class={tagsContainerStyle}>
            {hashtags.map((tag) => (
              <span class={badge({ variant: 'default' })}>#{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </article>
</Layout>
